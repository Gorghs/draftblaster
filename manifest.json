{
  "manifest_version": 3,
  "name": "DraftBlaster",
  "version": "1.0.0",
  "description": "Personal-use browser extension for automated Gmail draft sending with human pacing and Gemini recovery.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "DraftBlaster"
  },
  "background": {
    "service_worker": "src/background/serviceWorker.ts",
    "scripts": ["src/background/serviceWorker.ts"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "draftblaster@personal.testing",
      "strict_min_version": "115.0"
    }
  }
}
