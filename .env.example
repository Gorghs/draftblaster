# ====================================================================
# Gmail Draft Auto-Sender - Environment Variables Template
# ====================================================================

# Port and Host (Render automatically populates $PORT)
PORT=8000
HOST=0.0.0.0

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Obtained via one-time visit to /auth/login, then saved here:
GOOGLE_REFRESH_TOKEN=

# Authorized OAuth redirect URI (e.g. https://your-service.onrender.com/auth/callback)
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Timezone & Schedule Time (24-hour format)
# Default: Asia/Kolkata (India Standard Time)
TIMEZONE=Asia/Kolkata
SEND_HOUR=9
SEND_MINUTE=0
EXECUTION_WINDOW_MINUTES=5

# Optional Secret to protect /trigger from unauthorized internet pings
# Call /trigger?secret=YOUR_SECRET or header 'x-trigger-secret'
TRIGGER_SECRET=your_secret_token_here

# Optional: Upstash Redis URL for distributed locking & multi-restart persistence on Render
# Format: rediss://default:password@your-endpoint.upstash.io:6379
REDIS_URL=

# Local State File Path (used when REDIS_URL is not set)
STATE_FILE_PATH=state.json
