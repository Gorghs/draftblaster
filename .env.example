# ====================================================================
# Gmail Draft Auto-Sender (App Password Configuration)
# ====================================================================

# Gmail Account & 16-character App Password (from myaccount.google.com/apppasswords)
EMAIL_GMAIL_USER=your_email@gmail.com
EMAIL_GMAIL_PASSWORD=abcd efgh ijkl mnop

# Timezone & Schedule Time (24-hour format)
# Default: Asia/Kolkata (India Standard Time)
TIMEZONE=Asia/Kolkata
SEND_HOUR=9
SEND_MINUTE=0
EXECUTION_WINDOW_MINUTES=5

# Optional Secret to protect /trigger from unauthorized web crawlers
# Example: https://your-service.onrender.com/trigger?secret=YOUR_SECRET
TRIGGER_SECRET=your_secret_token_here

# Optional: Upstash Redis URL for distributed locking & restart resilience on Render
# Format: rediss://default:password@your-endpoint.upstash.io:6379
REDIS_URL=

# Local State File Path (used when REDIS_URL is not set)
STATE_FILE_PATH=state.json
